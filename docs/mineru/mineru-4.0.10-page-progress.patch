+"""Report PDF analysis progress to the current API job, including worker threads."""
+
+from contextvars import ContextVar
+from typing import Callable
+
+
+page_progress_callback: ContextVar[Callable[[int, int, str], None] | None] = ContextVar(
+    "mineru_page_progress_callback", default=None
+)
+
+
+def report_pdf_progress(completed: int, total: int, stage: str = "processing") -> None:
+    callback = page_progress_callback.get()
+    if callback is not None:
+        callback(completed, total, stage)
